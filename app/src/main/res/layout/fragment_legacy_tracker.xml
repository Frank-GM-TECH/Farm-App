<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/legacy_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/legacy_title"
                android:textSize="22sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/legacy_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legacy_close" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:text="@string/legacy_demo_warning" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/legacy_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="88dp"
                android:clipToPadding="false" />
            <TextView
                android:id="@+id/legacy_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="24dp"
                android:textAlignment="center"
                android:text="@string/legacy_empty" />
        </FrameLayout>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/legacy_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/legacy_add"
        app:backgroundTint="@color/farmapp_launcher_green"
        app:srcCompat="@drawable/ic_legacy_add"
        app:tint="@android:color/white" />
</FrameLayout>
