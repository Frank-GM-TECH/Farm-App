<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <EditText
        android:id="@+id/legacy_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/room_name"
        android:inputType="textCapSentences"
        android:maxLength="70"
        android:singleLine="true" />
    <EditText
        android:id="@+id/legacy_item_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/room_price"
        android:inputType="numberDecimal"
        android:singleLine="true" />
    <EditText
        android:id="@+id/legacy_item_stock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/room_stock"
        android:inputType="number"
        android:singleLine="true" />
    <TextView
        android:id="@+id/legacy_form_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3261E"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
